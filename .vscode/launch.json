{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: intake against sample data",
      "type": "debugpy",
      "request": "launch",
      "module": "confirmation_agent.main",
      "args": ["--input", "sample_data/confirmation-management-input-package.xlsx"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Debug: current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
