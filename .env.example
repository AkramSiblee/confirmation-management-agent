# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Google Workspace (Gmail draft-only + Drive file-scoped) ---
GMAIL_CREDENTIALS_PATH=./secrets/gmail_client_secret.json
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
DRIVE_ROOT_FOLDER_ID=

# Mailbox that all confirmation/chase drafts are created from.
# Must be an audit-team-controlled mailbox — never a client-provided address
# (see docs/workflow-skill.md Section 2, "control over the confirmation process").
AUDIT_TEAM_MAILBOX=confirmations@yourfirm.com

# --- Engagement default (override per run with --input) ---
DEFAULT_INPUT_WORKBOOK=sample_data/confirmation-management-input-package.xlsx
